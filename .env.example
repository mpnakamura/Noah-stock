# IMPORTANT: Create .env.local (not .env) and add your API key
# Copy this file: cp .env.example .env.local
# Then edit .env.local with your real API key

# Anthropic Claude API Key
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model Info:
# Currently using: claude-sonnet-4-5 (latest Claude Sonnet 4.5 model)
# This is the recommended model name format per Anthropic SDK documentation
# Make sure your API key has access to this model
# If you get 404 errors, check your model access at https://console.anthropic.com/

# After creating .env.local with your real key:
# 1. Restart the dev server: npm run dev
# 2. Check the terminal for any errors
# 3. The key should be loaded automatically
